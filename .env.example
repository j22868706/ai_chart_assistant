TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
GROQ_API_KEY=replace_with_your_groq_api_key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user IDs, not usernames. Empty configuration blocks startup.
TELEGRAM_ALLOWED_USER_IDS=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave blank for automatic input-language detection (recommended).
# Set en, zh, etc. only for an intentional single-language input hint.
GROQ_STT_LANGUAGE=
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Limits are per process; run one Uvicorn worker for local use.
MAX_WEBHOOK_BYTES=65536
MAX_AUDIO_BYTES=10485760
MAX_VOICE_SECONDS=300
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180
# Use a separate database for each bot. Keep it across application restarts.
TELEGRAM_UPDATE_DB_PATH=state/telegram_updates.sqlite3
